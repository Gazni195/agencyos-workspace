# ERPNext backend integration (not yet wired up — see docs/erpnext-integration.md)
#
# These are placeholders for a future phase. Nothing in the app reads them
# today; the frontend runs entirely on local seed data under src/data/.
#
# VITE_ERPNEXT_BASE_URL=https://your-site.erpnext.com
#
# API key/secret should be read server-side only (in a TanStack Start
# server function) and never exposed with a VITE_ prefix, since anything
# prefixed VITE_ is bundled into client-side JS:
# ERPNEXT_API_KEY=
# ERPNEXT_API_SECRET=
