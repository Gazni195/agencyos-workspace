# Supabase — the app's real backend (database, auth, file storage), used as
# an interim backend while a custom-hosted one is built separately. See
# supabase/migrations/ for the database schema and
# docs/supabase-integration.md for the plan.
#
# Get these from your Supabase project dashboard -> Settings -> API.
#
# Safe to expose in the browser (VITE_ prefix = bundled into client JS);
# access control is enforced by Postgres Row Level Security, not by this
# key being secret:
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
#
# Server-only — NEVER prefix these with VITE_. The service_role key
# bypasses all Row Level Security, so it must never reach the browser:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ERPNext backend integration (not yet wired up — see docs/erpnext-integration.md)
#
# These are placeholders for a possible future phase, kept from an earlier
# evaluation. Nothing in the app reads them today.
#
# VITE_ERPNEXT_BASE_URL=https://your-site.erpnext.com
#
# API key/secret should be read server-side only (in a TanStack Start
# server function) and never exposed with a VITE_ prefix, since anything
# prefixed VITE_ is bundled into client-side JS:
# ERPNEXT_API_KEY=
# ERPNEXT_API_SECRET=
